    <Action Name="callMoveZ" Id="{5912fd16-bb08-481c-aca5-5b7332759a0d}">
      <Implementation>
        <ST><![CDATA[CASE seqMoveZM[i] OF

INIT:
	seqMoveZM[i]:=READY;
	Constratint_ZABC[i].SetLimit(
		Coordinate:= Coord_Mcs_A1, 
		V:= 100 , 
		A:= 100 , 
		D:= 100, 
		J:= 1000);
	
READY:
	IF moveZM[i]THEN
		MoveZM[i] := FALSE;	
		Constratint_ZABC[i].AddLimit(
			Coordinate:= Coord_Mcs_A1, 
			V:= 100 , 
			A:= 100 , 
			D:= 100, 
			J:= 1000);
		Xpmover[i].MoveZ(
			commandFeedback:=xpFeedback[i].sName.CallMoveZ , 
			targetPosition:=positionTargetZ[i] , 
			constraint:=ConstraTINT_zabc[i]);
		seqMoveZM[i]:=BUSY;
	END_IF
		
BUSY:
    IF XpFeedback[i].sName.CallMoveZ.Done THEN
		seqMoveZM[i]:=DONE;
    ELSIF Xpfeedback[i].sName.CallMoveZ.Aborted THEN
		seqMoveZM[i]:=ABORT;
	ELSIF Xpfeedback[i].sName.CallMoveZ.Error THEN	
		seqMoveZM[i]:=ERROR;
	END_IF
	
DONE:
	IF NOT MoveZM[i] THEN
	   seqMoveZM[i]:=READY;
	END_IF
	
ERROR:
	IF NOT MoveZM[i] THEN
	   seqMoveZM[i]:=READY;
	END_IF
	
ABORT:
	IF NOT MoveZM[i] THEN
	   seqMoveZM[i]:=READY;
	END_IF
		
END_CASE

]]></ST>
      </Implementation>
    </Action>
    <Action Name="CallReset" Id="{828a4503-afb1-47e9-ae13-1d648590f200}">
      <Implementation>
        <ST><![CDATA[CASE seqResetM[i] OF
	
INIT:
	seqResetM[i]:=READY;

READY:
	IF ResetM[i]THEN
		Xpmover[i].Reset(commandFeedback:=XpFeedBack[i].sName.CallReset);
		seqResetM[i]:=BUSY;
	END_IF
		
BUSY:
	IF xpFeedback[i].sName.CallReset.Done THEN
		ResetM[i]:=FALSE;
		seqResetM[i]:=DONE;
	END_IF
		
DONE:
	IF NOT ResetM[i] THEN
		seqResetM[i]:=READY;
	END_IF

END_CASE
]]></ST>
      </Implementation>
    </Action>
    <Action Name="seq_JoinTrack" Id="{a8fc712c-0239-442a-a002-ee8d18045139}">
      <Implementation>
        <ST><![CDATA[IF NOT bJoinTrackseq THEN
	FOR i :=0 TO 1(*GVL.MAX_MOVER*) DO
			pSortedMovers[i] := ADR(Xpmover[i]);
		END_FOR
		
	FOR i := 0 TO 1(*GVL.MAX_MOVER*)-1 DO
		FOR j := i+1 TO  1(*GVL.MAX_MOVER*) DO
			IF pSortedMovers[i]^.MCTOPLC.ACT.ActPos.x > pSortedMovers[j]^.MCTOPLC.ACT.ActPos.x THEN
				pTemp := pSortedMovers[i];
				pSortedMovers[i] := pSortedMovers[j];
				pSortedMovers[j] := ptemp;
			END_IF
		END_FOR
	END_FOR
	pMover_1st  := pSortedMovers[0];
	pMover_2nd	:= pSortedMovers[1];
END_IF

FOR i:=0 TO gvl.MAX_MOVER DO
		ConstraintXY[i].SetValuesVADJ(V:=velocity_xy[i] , A:=15000 , D:=15000 , J:=100000 );
		velocity_xy[i] := 50;
END_FOR
	
CASE nJoinStep OF
	0:
	IF bJoinTrackseq THEN
		bJoinTrackseq := FALSE;
		nJoinStep := 10;
	END_IF

	10:
	pMover_1st^.JoinTrack(commandFeedback:= Xpfeedback[0].sName.SeqJoinTrack,
			targetTrack := XpTrack[E_TrackName.Wait],
			constraint	:= constraintXY[0],
			options := 0);
	IF Xpfeedback[0].sName.SeqJoinTrack.Busy THEN
		nJoinStep := 20;
	END_IF
	
	20:
	IF Xpfeedback[0].sName.SeqJoinTrack.Done THEN
		nJoinStep := 30;
	END_IF
	
	30:
	pMover_2nd^.JoinTrack(commandFeedback:= Xpfeedback[1].sName.SeqJoinTrack,
		targetTrack := XpTrack[E_TrackName.ToFillB],
		constraint	:= constraintXY[1],
		options := 0);
	IF Xpfeedback[1].sName.SeqJoinTrack.Busy THEN
		nJoinStep := 40;
	END_IF

	40:
	IF Xpfeedback[1].sName.SeqJoinTrack.Done THEN
		nJoinStep := 50;
	END_IF

END_CASE
(*
FOR i:=0 TO GVL.MAX_MOVER DO
	IF xpMover[i].MCTOPLC.STD.CommandMode <> MC.MC_PLANAR_MOVER_COMMAND_MODE.JoiningTrack THEN
		fbStateTrack[i].bstart := TRUE;
	ELSE
		fbStateTrack[i].bstart := FALSE;
	END_IF
END_FOR
*)

IF GVL.bfill THEN
	GVL.bfill  := FALSE;
END_IF

diCountSum := 0;
FOR i:=0 TO GVL.MAX_MOVER DO
	diCountSum := diCountSum + fbStateTrack[i].icount;
END_FOR

IF CountReset THEN
	CountReset := FALSE;
	FOR i:=0 TO GVL.MAX_MOVER DO
		fbStateTrack[i].breset := TRUE;
	END_FOR
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="update" Id="{b905cfd4-917c-4c0a-aedb-a2dd8d9f08d9}">
      <Implementation>
        <ST><![CDATA[FOR i:=0 TO gvl.MAX_MOVER DO //xpmover 
	XpMover[i].update();
	FOR k:=0 TO MAX_FEEDBACK DO	
		Xpfeedback[i].aArray[k].Update();
	END_FOR
END_FOR

FOR t:=0 TO MAX_TRACK DO
    XpTrack[t].Update();
END_FOR]]></ST>
      </Implementation>
    </Action>
  </POU>
</TcPlcObject>