    <Action Name="CallReset" Id="{828a4503-afb1-47e9-ae13-1d648590f200}">
      <Implementation>
        <ST><![CDATA[//Reset

	CASE seqResetM[i] OF
		INIT:
         seqResetM[i]:=READY;
	 READY:
	 IF ResetM[i]THEN
		Xpmover[i].Reset(commandFeedback:=XpFeedBack[i][5]);
		seqResetM[i]:=BUSY;
		END_IF
		
		BUSY:
		IF xpFeedback[i][5].Done THEN
		   ResetM[i]:=FALSE;
		   seqResetM[i]:=DONE;
		END_IF
		
		DONE:
		IF NOT ResetM[i] THEN
	       seqResetM[i]:=READY;
		END_IF
	END_CASE
]]></ST>
      </Implementation>
    </Action>
    <Action Name="update" Id="{b905cfd4-917c-4c0a-aedb-a2dd8d9f08d9}">
      <Implementation>
        <ST><![CDATA[FOR i:=0 TO MAX_MOVER DO //xpmover 
	XpMover[i].update();
	FOR k:=0 TO MAX_FEEDBACK DO	
		Xpfeedback[i][k].Update();
	END_FOR
END_FOR
FOR t:=0 TO MAX_TRACK DO
    XpTrack[t].Update();
END_FOR]]></ST>
      </Implementation>
    </Action>
  </POU>
</TcPlcObject>