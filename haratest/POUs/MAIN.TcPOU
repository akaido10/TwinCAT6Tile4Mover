    <Action Name="callMoveZ" Id="{5912fd16-bb08-481c-aca5-5b7332759a0d}">
      <Implementation>
        <ST><![CDATA[//MoveZ

	CASE seqMoveZM[i] OF
	INIT:
        seqMoveZM[i]:=READY;
Constratint_ZABC[i].SetLimit(
	Coordinate:= Coord_Mcs_A1, 
	V:= 100 , 
	A:= 100 , 
	D:= 100, 
	J:= 1000);
	
	 READY:
	IF moveZM[i]THEN
   Constratint_ZABC[i].AddLimit(
	Coordinate:= Coord_Mcs_A1, 
	V:= 100 , 
	A:= 100 , 
	D:= 100, 
	J:= 1000);
	 Xpmover[i].MoveZ(
commandFeedback:=xpFeedback[i][22] , 
targetPosition:=positionTargetZ[i] , 
constraint:=ConstraTINT_zabc[i]);
		
	 
		seqMoveZM[i]:=BUSY;
		END_IF
		
		
   BUSY:
